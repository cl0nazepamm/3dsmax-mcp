# Live smoke run output (redirected stdout/stderr)
smoke_out.json
smoke_err.txt

# Local test suites and diagnostics.
/tests/
/native/tests/
/docs/AGENT-VIEWPORT.md
/docs/MODELING-DEVELOPMENT.md

# Developer scripts are local. Three stay tracked because tracked code runs them: the
# native build (native/CMakeLists.txt) runs the two generators, and install.py and the
# wheel need build_skill.py.
/scripts/*
!/scripts/codegen/
/scripts/codegen/*
!/scripts/codegen/gen_tool_registry.py
!/scripts/codegen/gen_tool_smoke.py
!/scripts/release/
/scripts/release/*
!/scripts/release/build_skill.py

# Native C++ build artifacts (but ship the binary)
native/build/
native/build-*/
native/build2027/
native/generated/
!native/bin/

# The staged ApplicationPlugins bundle (build.bat / stage_bundle.py). Its manifest
# template and MAXScript listener are in maxmcp/assets.
/bundle/

# Dev convenience scripts are personal — install.py is the user-facing installer,
# build.bat/clean.bat stay for devs who want a bare build. Everything else is local.
dev.bat
native/dev.bat
native/deploy.bat
