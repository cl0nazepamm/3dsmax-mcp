__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.egg-info/
dist/
/installer/
build/
.venv/
*.egg
.DS_Store
.claude/
.agents/
AGENTS.md
TODO.md
PROJECT_OVERVIEW.md
nul
cache/
local/
.env

# Live smoke run output (redirected stdout/stderr)
smoke_out.json
smoke_err.txt

# Local test suites and diagnostics.
/tests/
/native/tests/
/docs/AGENT-VIEWPORT.md
/docs/MODELING-DEVELOPMENT.md

# Developer scripts are local. Three stay tracked because tracked code runs them: the
# native build (native/CMakeLists.txt) runs the two generators, and install.py runs
# vendor_inmax.py.
/scripts/*
!/scripts/codegen/
/scripts/codegen/*
!/scripts/codegen/gen_tool_registry.py
!/scripts/codegen/gen_tool_smoke.py
!/scripts/release/
/scripts/release/*
!/scripts/release/vendor_inmax.py

# The tool layer's packages for the Python of each 3ds Max before 2027, installed by
# scripts/release/vendor_inmax.py from the tracked cp*.txt lists beside them.
/maxmcp/inmax/site/*/

# Native C++ build output. native/bin (where the built bridges and _mx are staged) is
# ignored by the .gitignore inside it, which keeps the folder in a checkout for the
# wheel's force-include.
native/build/
native/build-*/
native/build2027/
native/generated/

# The staged ApplicationPlugins bundle. Its manifest
# template and MAXScript listener are in maxmcp/assets.
/bundle/

# Batch files are personal build and deploy shortcuts. install.py is the user-facing
# installer, and docs/ADVANCED.md gives the CMake commands for a build.
*.bat
