<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prebuilt tyFlow script checker for 3ds Max versions whose CSharpUtilities has no
       CSharpCompilationHelper (2023-2025). netstandard2.0 loads on .NET Framework 4.8 and .NET 8.
       Build: dotnet build -c Release, then copy bin/Release/netstandard2.0/*.dll to ./lib -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AssemblyName>McpTyScriptChecker</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../tyflow_script_checker.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
</Project>
