{
  "preset": 1,
  "id": "arnold",
  "label": "Arnold",
  "renderers": [[2980329694, 2688902778]],
  "verified": "MAXtoA for 3ds Max 2027: every recipe created, updated and read back through render_setup, and the raw Arnold Light, ai_image, Sun Positioner and renderer parameters checked. Not yet rendered.",
  "notes": [
    "Lights are Arnold Lights. Intensity is Arnold's own number with exposure kept at 0; MAXtoA's default light is intensity 1 at exposure 6, which is 64 here. Arnold Lights have no physical units.",
    "sphere is an Arnold point light with a radius.",
    "hdri is a skydome light with an Arnold image map. Its rotation is not bound yet.",
    "sun is a Sun Positioner in manual mode with a Physical Sun & Sky environment bound to it, placed by elevation and azimuth.",
    "samples is Arnold's Camera (AA) samples: each pixel gets its square. The denoiser is an imager (ai_imager_denoiser_oidn) and is not bound."
  ],
  "recipes": {
    "_light": {
      "objects": {"light": {"class": [1728442381, 3390250245], "super": "light"}},
      "set": {"targeted": false, "useColor": true},
      "aim": "-z",
      "defaults": {"kelvin": 6500},
      "fields": {
        "enabled": "on",
        "cast_shadows": "cast_shadows",
        "visible": "lightShapeVisible",
        "kelvin": {"param": "kelvin", "with": {"useKelvin": true}, "min": 1000, "max": 20000},
        "rgb": {"param": "color", "with": {"useKelvin": false}}
      },
      "intensity": {
        "units": {"renderer": {"param": "intensity", "with": {"exposure": 0}}},
        "default": {"value": 64, "unit": "renderer"}
      }
    },
    "rectangle": {
      "extends": "_light",
      "match": {"shapeType": 3},
      "set": {"shapeType": 3},
      "oriented": true,
      "requires": ["width", "height"],
      "fields": {"width": "quadX", "height": "quadY"}
    },
    "disk": {
      "extends": "_light",
      "match": {"shapeType": 4},
      "set": {"shapeType": 4},
      "oriented": true,
      "requires": ["radius"],
      "fields": {"radius": "lightRadius"}
    },
    "sphere": {
      "extends": "_light",
      "match": {"shapeType": 0},
      "set": {"shapeType": 0},
      "requires": ["radius"],
      "fields": {"radius": "lightRadius"}
    },
    "cylinder": {
      "extends": "_light",
      "match": {"shapeType": 5},
      "set": {"shapeType": 5},
      "oriented": true,
      "requires": ["radius", "length"],
      "fields": {"radius": "lightRadius", "length": "height"}
    },
    "hdri": {
      "objects": {
        "light": {"class": [1728442381, 3390250245], "super": "light"},
        "image": {"class": [2121471519, 2907943210], "super": "texmap"}
      },
      "match": {"shapeType": 6},
      "set": {"shapeType": 6, "targeted": false, "useColor": true, "color": [1.0, 1.0, 1.0], "useTexmap": true, "texmap": "@image"},
      "aim": "none",
      "requires": ["path"],
      "fields": {
        "enabled": "on",
        "cast_shadows": "cast_shadows",
        "path": {"param": "image.filename", "extensions": [".exr", ".hdr"]}
      },
      "intensity": {
        "units": {"renderer": {"param": "intensity", "with": {"exposure": 0}}},
        "default": {"value": 1, "unit": "renderer"}
      }
    },
    "sun": {
      "objects": {
        "light": {"class": [670970524, 1903123237], "super": "light"},
        "sky": {"class": [573786548, 1445625227], "super": "texmap"}
      },
      "match": {"mode": 0},
      "set": {"mode": 0, "sky.sun_position_object": "@light:node"},
      "environment": "@sky",
      "aim": "none",
      "requires": ["elevation"],
      "defaults": {"azimuth": 180},
      "fields": {
        "enabled": "sky.sun_enabled",
        "elevation": {"param": "altitude_deg", "min": -90, "max": 90},
        "azimuth": {"param": "azimuth_deg", "min": 0, "max": 360},
        "north": "north_direction_deg",
        "sky_intensity": {"param": "sky.sky_intensity", "min": 0},
        "haze": {"param": "sky.haze", "min": 0},
        "size": {"param": "sky.sun_disc_scale", "min": 0}
      },
      "intensity": {
        "units": {"renderer": {"param": "sky.global_intensity"}},
        "default": {"value": 1, "unit": "renderer"}
      }
    }
  },
  "settings": {
    "samples": {"param": "AA_samples", "min": 1, "max": 100}
  },
  "quality": {
    "draft": {"samples": 2},
    "preview": {"samples": 4},
    "final": {"samples": 6}
  },
  "enums": [
    {
      "super": 48,
      "class": [1728442381, 3390250245],
      "block": 0,
      "id": 18,
      "param": "shapeType",
      "values": {"point": 0, "spot": 2, "quad": 3, "disc": 4, "cylinder": 5, "skydome": 6, "photometric": 7, "mesh": 8},
      "complete": false,
      "evidence": "MAXtoA 2027 scripts: SceneConverter/ConversionScripts/PhotometricToArnold.ms (AI_POINT 0, AI_SPOT 2, AI_QUAD 3, AI_DISC 4, AI_CYLINDER 5, AI_PHOTOMETRIC 7), VrayLight_To_ArnoldLight.ms (dome light to 6, mesh light to 8), maxscript/arnoldlight_*manip.ms"
    }
  ]
}
